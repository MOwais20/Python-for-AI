# Copy to .env and add your provider key. OPEN_ROUTER_KEY is also accepted.
OPENROUTER_API_KEY=
# Choose models your OpenRouter account can access; the chat model needs tool calling.
CHAT_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-8b:free

# LLM choice: build_graph("ollama") or build_graph("grok")
OLLAMA_MODEL=qwen3:4b
GROK_API_KEY=
GROK_MODEL=grok-4
